{
  "name": "@warranty-management/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx dev @warranty-management/office-portal",
    "dev": "nx dev @warranty-management/office-portal",
    "build": "nx build @warranty-management/office-portal",
    "preview": "nx preview @warranty-management/office-portal",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test -- --coverage",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx e2e @warranty-management/office-portal-e2e",
    "e2e:auth": "nx e2e-auth @warranty-management/office-portal-e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "deploy": "nx build @warranty-management/office-portal && firebase deploy --config apps/office-portal/firebase.json --project role-base-login-app",
    "deploy:hosting": "nx build @warranty-management/office-portal && firebase deploy --only hosting --config apps/office-portal/firebase.json --project role-base-login-app",
    "deploy:rules": "firebase deploy --only firestore:rules --config apps/office-portal/firebase.json --project role-base-login-app"
  },
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "firebase": "^11.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "^1.37.0",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "firebase-tools": "^15.33.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "workspaces": [
    "apps/*",
    "libs/office-portal/*"
  ]
}
